// Prisma Schema for EventGenius Enterprise AI Event Planning Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  WEDDING
  BIRTHDAY
  COMMUNITY
}

enum CollaboratorRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum BudgetCategory {
  CATERING
  VENUE
  DECOR
  ENTERTAINMENT
  PHOTO_VIDEO
  ATTIRE
  MISC
}

enum BudgetStatus {
  ESTIMATED
  RESERVED
  PAID
}

enum TimelinePhase {
  PLANNING
  SETUP
  EVENT_DAY
  WRAP_UP
}

enum VendorStatus {
  RESEARCHING
  CONTACTED
  QUOTE_RECEIVED
  HIRED
  REJECTED
}

enum IdeaCategory {
  THEME
  ACTIVITY
  MENU
  DECOR
}

model User {
  id            String              @id @default(uuid())
  email         String              @unique
  name          String
  passwordHash  String              @map("password_hash")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  events        Event[]             @relation("UserEvents")
  collaborations EventCollaborator[]

  @@map("users")
}

model Event {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  title         String
  eventType     EventType           @map("event_type")
  targetDate    DateTime            @map("target_date")
  location      String
  totalBudget   Decimal             @default(0) @db.Decimal(12, 2) @map("total_budget")
  currency      String              @default("USD")
  guestCount    Int                 @default(50) @map("guest_count")
  themeNotes    String?             @db.Text @map("theme_notes")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user          User                @relation("UserEvents", fields: [userId], references: [id], onDelete: Cascade)
  collaborators EventCollaborator[]
  budgetItems   BudgetItem[]
  timelineItems TimelineItem[]
  vendors       VendorChecklist[]
  aiIdeas       AIIdeaLog[]

  @@index([userId])
  @@index([eventType])
  @@index([targetDate])
  @@map("events")
}

model EventCollaborator {
  id        String           @id @default(uuid())
  eventId   String           @map("event_id")
  userId    String           @map("user_id")
  role      CollaboratorRole @default(COLLABORATOR)
  createdAt DateTime         @default(now()) @map("created_at")

  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@map("event_collaborators")
}

model BudgetItem {
  id            String         @id @default(uuid())
  eventId       String         @map("event_id")
  category      BudgetCategory
  name          String
  estimatedCost Decimal        @default(0) @db.Decimal(12, 2) @map("estimated_cost")
  actualCost    Decimal        @default(0) @db.Decimal(12, 2) @map("actual_cost")
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2) @map("paid_amount")
  status        BudgetStatus   @default(ESTIMATED)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
  @@map("budget_items")
}

model TimelineItem {
  id          String        @id @default(uuid())
  eventId     String        @map("event_id")
  title       String
  description String?       @db.Text
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  phase       TimelinePhase @default(PLANNING)
  isCompleted Boolean       @default(false) @map("is_completed")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([phase])
  @@index([startTime])
  @@map("timeline_items")
}

model VendorChecklist {
  id           String       @id @default(uuid())
  eventId      String       @map("event_id")
  category     String
  vendorName   String       @map("vendor_name")
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  contractUrl  String?      @map("contract_url")
  notes        String?      @db.Text
  status       VendorStatus @default(RESEARCHING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@map("vendor_checklists")
}

model AIIdeaLog {
  id         String       @id @default(uuid())
  eventId    String       @map("event_id")
  category   IdeaCategory
  content    String       @db.Text
  isFavorite Boolean      @default(false) @map("is_favorite")
  createdAt  DateTime     @default(now()) @map("created_at")

  event      Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
  @@map("ai_idea_logs")
}
