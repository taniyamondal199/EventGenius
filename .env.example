# EventGenius Enterprise AI Event Planning Assistant
# Database - PostgreSQL (Supabase / Neon DB / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventgenius?schema=public"

# Authentication & Security
JWT_SECRET="eventgenius-enterprise-jwt-super-secure-key-32chars-min-2025"
NEXTAUTH_SECRET="eventgenius-enterprise-jwt-super-secure-key-32chars-min-2025"
NEXTAUTH_URL="http://localhost:3000"

# AI Engine (OpenAI GPT-4o / Anthropic Claude 3.5 Sonnet)
# If left blank, EventGenius utilizes high-fidelity structured heuristic engine for offline/demo workflows!
OPENAI_API_KEY=""

# Upstash Redis (Optional for production distributed sliding window rate limiting)
# Fallback to in-memory sliding window rate limiter is included automatically
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
